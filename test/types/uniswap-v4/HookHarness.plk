import std::constructor::return_runtime;

// RED: implementation modules land in Tasks 5-6
import types::uniswap_v4::Hook::*;
import types::uniswap_v4::HookFlags::*;

init {
    return_runtime();
}

run {
    // cast sig "mineAndDeployHook(uint256,bytes,bytes)" -> 0xa6edb614
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == 0xa6edb614 {
        @evm_revert(@malloc_uninit(0), 0);
    }
    @evm_stop();
}
