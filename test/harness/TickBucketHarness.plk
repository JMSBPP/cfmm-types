import std::constructor::return_runtime;
import types::TickBucket::TickBucket;
import types::TickSpacing::TickSpacing;

// tickBucket(uint24) → (int256 min, int256 max)
const TICK_BUCKET = 0x6899efb7;

init { return_runtime(); }

run {
	let selector = @evm_shr(224, @evm_calldataload(0));
	if selector == TICK_BUCKET {
		let spacing = @evm_calldataload(4);
		let b = TickBucket(TickSpacing(spacing));
		let out = @malloc_uninit(64);
		@mstore32(out, b.min);
		@mstore32(out +% 32, b.max);
		@evm_return(out, 64);
	}
	@evm_stop();
}
