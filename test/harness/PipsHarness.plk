import std::constructor::return_runtime;
import std::core::uint::cast_uint;
import cfmm_types::Pips::intro;

/// intro(uint256,uint256)
const SEL_INTRO = 0x2b15fcd3;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SEL_INTRO {
        let p = intro(@evm_calldataload(4), @evm_calldataload(36));
        let out = @malloc_uninit(32);
        @mstore32(out, cast_uint(p.val, u256));
        @evm_return(out, 32);
    }
    @evm_stop();
}
