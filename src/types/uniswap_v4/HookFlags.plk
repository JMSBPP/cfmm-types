import std::core::uint::{u160, cast_uint, unsafe_from_u256, try_cast_uint};
import std::option::unwrap;

const HookFlags = struct { bits: u160 };

const ALL_HOOK_MASK = comptime { unsafe_from_u256(u160, 0x3FFF) };

const BEFORE_SWAP_FLAG = comptime { unsafe_from_u256(u160, 128) };

const hook_flags = fn (raw: u256) HookFlags {
    HookFlags { bits: unwrap(try_cast_uint(raw & 0x3FFF, u160)) }
};

const hook_flag_bits = fn (flags: HookFlags) u256 {
    cast_uint(flags.bits, u256)
};
