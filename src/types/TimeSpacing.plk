import std::error::comptime_assert;
import cfmm_types::Window::*;
import cfmm_types::Ray::Ray;

// -- types.toml: TimeSpacing
// TimeSpacing ← dt̄ := { dt ∈ u8 | dt ∈ {2,3,4,5,6,8,9,10} }
// W = Window()
// N = W / dt̄ ∈ ℕ
// M = 65536
// i(t) = ⌊(t − t_init)/dt̄⌋ mod M
// lastIndex(t) = i(t)
// windowStartIndex(t) = (i(t) − N) mod M
// ring period M·dt̄ > W  (dt̄ ≥ 2 ⇒ M·dt̄ ≥ 131072 > 86400)
//
// #26 sqrt_dt(self: TimeSpacing(dt)) → Ray
// Ray carrier: cfmm_types::Ray (define #32 landed)
// hole: sqrt_dt body — define phase; law floor(√dt · RAY) via table below

const RING = 65536;

const TimeSpacing = fn (comptime dt: u256) u256 {
    comptime_assert(
        (dt == 2) | (dt == 3) | (dt == 4) | (dt == 5) | (dt == 6) | (dt == 8) | (dt == 9) | (dt == 10),
        "TimeSpacing: dt not in {2,3,4,5,6,8,9,10}"
    );
    comptime_assert(comptime { (Window() </ dt) *% dt == Window() }, "TimeSpacing: N = Window/dt must be in N");
    comptime_assert(comptime { (RING *% dt) > Window() }, "TimeSpacing: ring period M*dt must exceed Window");
    dt
};

const n = fn (comptime dt: u256) u256 {
    Window() </ TimeSpacing(dt)
};

/// floor(√dt · RAY) for TimeSpacing domain — comptime table (not getSqrtRatioAtTick).
const SQRT_DT_RAY_2 = 1414213562373095048801688724;
const SQRT_DT_RAY_3 = 1732050807568877293527446341;
const SQRT_DT_RAY_4 = 2000000000000000000000000000;
const SQRT_DT_RAY_5 = 2236067977499789696409173668;
const SQRT_DT_RAY_6 = 2449489742783178098197284074;
const SQRT_DT_RAY_8 = 2828427124746190097603377448;
const SQRT_DT_RAY_9 = 3000000000000000000000000000;
const SQRT_DT_RAY_10 = 3162277660168379331998893544;

