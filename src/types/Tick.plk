import types::TickSpacing::TickSpacing;
import std::core::uint::{cast_uint, try_cast_uint, u24};
import std::option::unwrap;

const Tick = fn(tickVal: u256, rawTickSpacing: u256) u256 {
      let mut tick = if @evm_slt(tickVal, 0) {
            - cast_uint(unwrap(try_cast_uint(0 -% tickVal, u24)), u256)
      } else {
            cast_uint(unwrap(try_cast_uint(tickVal, u24)), u256)
      };
      let tickSpacing = cast_uint(TickSpacing(rawTickSpacing), u256);
      let mut q = @evm_sdiv(tick, tickSpacing);
      // Floor toward -inf so negative ticks snap down to spacing (SDIV truncates toward 0).
      if @evm_slt(tick, 0) & (@evm_smod(tick, tickSpacing) != 0) {
            q = q -% 1;
      }
      q *% tickSpacing
};

const U24_MAX: u256 = 0xffffff;

// Comptime T is the return type of Tick (u256) or TickSpacing (u24).
// Tick bounds = Tick constructed from ±u24::MAX under the given spacing.
const max = fn (comptime T: type, rawTickSpacing: u256) T {
	comptime {
		if (T != u256) & (T != u24) {
			@compile_error("max: T must be u256 (Tick) or u24 (TickSpacing)");
		}
	}
	if T == u256 {
		Tick(U24_MAX, rawTickSpacing)
	} else {
		TickSpacing(200)
	}
};

const min = fn (comptime T: type, rawTickSpacing: u256) T {
	comptime {
		if (T != u256) & (T != u24) {
			@compile_error("min: T must be u256 (Tick) or u24 (TickSpacing)");
		}
	}
	if T == u256 {
		Tick(0 -% U24_MAX, rawTickSpacing)
	} else {
		TickSpacing(1)
	}
};
