import std::option::{Option, Some, None, is_some, is_none, unwrap};
import std::error::require;
import std::core::uint::{u24, is_uint, try_cast_uint};


const UNITIALIZED_TICK_SPACING = 201;
// $T denotes type_index
// over a type_index one can take _type_of(type_index)
const TickSpacing = fn(ts: u256) u24 {
      let mut val = if ts > 200 {
            unwrap(try_cast_uint(200, u24))
      } else if ts == 0 {
            unwrap(try_cast_uint(1, u24))
      } else {
            unwrap(try_cast_uint(ts, u24))
      };
      val
};
 

