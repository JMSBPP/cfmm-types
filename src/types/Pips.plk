/// -- types.toml: Pips
/// Behavior source (define): .spec/types/Pips/Pips.btt
/// Track: https://github.com/JMSBPP/cfmm-types/issues/27
///
/// IMPROVE: v1 `intro` takes two untyped u256 (v1 ≈ Ray-scale √, v2 ≈ shock mag).
/// Tighten to typed carriers (e.g. Ray × mag) once those tracks land.
///
/// Algebra:
///   PIPS = 10^6
///   Pips = { val: u16 }
///   intro(v1,v2) = Pips{ val: u16(mulDiv(v1,v2,PIPS)) }
///   mulDiv ∉ u16 ⇒ revert
///   Eff = []

import std::core::uint::{u16, try_cast_uint};
import std::core::ops::{checked_mul, checked_div_down};
import std::option::unwrap;

/// Algebra FEE_DENOMINATOR — pip scale (1e6 ≈ 1σ).
const PIPS = 1000000;

const Pips = struct {
    val: u16
};

/// mulDiv := checked_div_down(checked_mul(v1, v2), PIPS); !fits u16 ⇒ revert
const intro = fn (v1: u256, v2: u256) Pips {
    let q = checked_div_down(checked_mul(v1, v2), PIPS);
    Pips { val: unwrap(try_cast_uint(q, u16)) }
};
